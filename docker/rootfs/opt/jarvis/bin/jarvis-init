#!/command/with-contenv sh
# JARVIS LNX: einmal pro Containerstart (root) – Ordner für hermes, dann Vorbereitung als hermes.
. /opt/jarvis/bin/jarvis-env
set -e
for d in /opt/models /opt/data/jarvis /opt/data/jarvis/logs /opt/data/jarvis/logs/ui /opt/data/jarvis/logs/admin /opt/data/jarvis/logs/stt; do
  mkdir -p "$d"
  [ "$(stat -c %U "$d")" = hermes ] || chown hermes:hermes "$d"
done
exec s6-setuidgid hermes $PY -I /opt/jarvis/app/first_run.py
