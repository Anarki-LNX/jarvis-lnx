# NuOrb-Server: gemeinsame Umgebung aller NuOrb-Dienste im Container (wird von den s6-run-Skripten eingelesen).
export HOME=/opt/nuorb/home NUORB_HOME=/opt/nuorb/home
export HERMES_HOME=/opt/data HERMES_BIN=/opt/hermes/bin/hermes
export NUORB_MODELS=/opt/models
export PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 ORT_DISABLE_TELEMETRY=1 HF_HUB_DISABLE_TELEMETRY=1
export LANG=C.UTF-8
: "${NUORB_LANG:=de}" "${UI_PORT:=8443}" "${ADMIN_PORT:=8444}" "${HERMES_API_PORT:=8642}" "${STT_ROUTER_PORT:=8178}"
export NUORB_LANG UI_PORT ADMIN_PORT HERMES_API_PORT STT_ROUTER_PORT
case "${NUORB_TLS:-selfsigned}" in off) SCHEME=http ;; *) SCHEME=https ;; esac
D=/opt/data/nuorb
export UI_CERT_DIR=$D/certs ADMIN_CERTS=$D/certs
export NUORB_SMARTHOME_MCP=/opt/nuorb/smarthome/smarthome_mcp.py   # Smart-Home-Modul im Image (Verwaltung: Testen/Schalten)
# Host-IP für Firewall-Befehle der Verwaltung (im Bridge-Netz kennt der Container nur seine eigene IP):
# NUORB_HOST_IP aus der .env, sonst die erste IPv4-Adresse aus NUORB_HOSTS
if [ -z "${NUORB_HOST_IP:-}" ]; then
  for h in $(printf '%s' "${NUORB_HOSTS:-}" | tr ',' ' '); do
    case "$h" in *[!0-9.]*|""|127.*) ;; *.*.*.*) NUORB_HOST_IP=$h; break ;; esac
  done
fi
[ -n "${NUORB_HOST_IP:-}" ] && export NUORB_HOST_IP
export BRAIN_SAVED_FILE=$D/admin/brain.json   # Typ des lokalen Gehirns (ollama|openai) für die Statusanzeige
export HERMES_CONFIG=/opt/data/config.yaml   # Gehirn-Adresse für die Statusanzeige (providers.pc-ollama.api)
export UI_CONFIG=$D/config/ui.json NUORB_UI_SETTINGS=$D/config/ui.json ADMIN_TOKEN_FILE=$D/config/internal.token
export ADMIN_DATA=$D/admin NUORB_UI_STATIC=/opt/nuorb/ui/static
export HERMES_URL=http://127.0.0.1:$HERMES_API_PORT
export STT_URL=http://127.0.0.1:$STT_ROUTER_PORT/v1/audio/transcriptions STT_HEALTH_URL=http://127.0.0.1:$STT_ROUTER_PORT/health
export STT_ROUTER_HOST=127.0.0.1 PARAKEET_DIR=/opt/models/stt/sherpa-onnx-nemo-parakeet-tdt-0.6b-v3-int8
export NUORB_UI_URL=$SCHEME://127.0.0.1:$UI_PORT ADMIN_URL=$SCHEME://127.0.0.1:$ADMIN_PORT
# Ollama: keine erfundene Vorgabe mehr (früher http://ollama:11434 = optionales Profil, meist nicht aktiv).
# Leer = Feld in der Einrichtung bleibt leer (Vorschlag nur, wenn das gebündelte Ollama-Profil läuft).
export OLLAMA_URL="${NUORB_INIT_OLLAMA_URL:-}"
export BRAIN_URL="${OLLAMA_URL:-http://127.0.0.1:11434}"; BRAIN_URL="${BRAIN_URL%/}/api/version"; export BRAIN_URL
# Heimnetz, VPN (100.64/10) und Link-Local. Nicht das ganze 172.16.0.0/12 (Docker-Netze), sondern nur der eigene
# Docker-Gateway: unter dieser Adresse erscheinen Clients, wenn Docker die Ports per Proxy weiterreicht (z. B. IPv6).
GW=$(awk '$2 == "00000000" {print $3; exit}' /proc/net/route 2>/dev/null)
[ -n "$GW" ] && GW=$(printf '%d.%d.%d.%d' "0x${GW#??????}" "0x$(printf '%s' "$GW" | cut -c5-6)" "0x$(printf '%s' "$GW" | cut -c3-4)" "0x${GW%??????}")
NETS="${NUORB_ALLOWED_NETS:-127.0.0.0/8,::1/128,10.0.0.0/8,192.168.0.0/16,100.64.0.0/10,fc00::/7,fe80::/10${GW:+,$GW/32}}"
export UI_ALLOWED_NETS="$NETS" ADMIN_ALLOWED_NETS="$NETS"
# Marke/Oberflächensprache (NuOrb-Oberfläche): BRAND_NAME, UI_LANG=de|en|auto, WAKE_PHRASE; ui.json hat Vorrang
export BRAND_NAME="${BRAND_NAME:-NuOrb}" UI_LANG="${UI_LANG:-auto}"
[ -n "${WAKE_PHRASE:-}" ] && export WAKE_PHRASE
[ -n "${ASSISTANT_NAME:-}" ] && export ASSISTANT_NAME
export ADMIN_LANG="${ADMIN_LANG:-en}"   # Admin-Webinterface: en (Standard) oder de
export NUORB_ONBOARDING="${NUORB_ONBOARDING:-1}"   # Begrüßung beim ersten Öffnen (NuOrb-Oberfläche)
export NUORB_MODE=live NUORB_FEATURE_ZUHAUSE="${NUORB_FEATURE_ZUHAUSE:-0}" NUORB_FEATURE_GERAET=0 NUORB_FEATURE_CLOUD_WEICHE="${NUORB_FEATURE_CLOUD_WEICHE:-0}"
export PATH="/opt/hermes/bin:/opt/hermes/.venv/bin:/command:/usr/local/bin:/usr/bin:/bin"
# shellcheck disable=SC2034  # wird von den s6-run-Skripten nach dem Einlesen benutzt
PY=/opt/nuorb/venv/bin/python
