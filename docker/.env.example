# ============================================================================
# NuOrb-Server – Einstellungen. Kopieren:  cp .env.example .env   und anpassen.
# Geheimnisse (API-Schlüssel) gehören NICHT hierher, sondern ins Admin-Panel.
# ============================================================================

# Sprache von Persona, Stimme und Spracherkennung: de | en
NUORB_LANG=de

# Zeitzone (NuOrb sagt die Uhrzeit an)
TZ=Europe/Berlin

# Server-Name, den Apps beim Koppeln anzeigen (leer = Name des Assistenten)
NUORB_NAME=

# Produktname in der Oberfläche (Titel, Begrüßung) und Weckwort „Hey <Name>“. Wie du den Assistenten
# ansprichst, legst du beim ersten Gespräch oder im Admin fest (Standard = dieser Name).
BRAND_NAME=NuOrb
# WAKE_PHRASE=Hey NuOrb
# ASSISTANT_NAME=NuOrb
# Begrüßung beim ersten Öffnen („Mein Schöpfer hat mich NuOrb getauft …“), 0 = aus
NUORB_ONBOARDING=1
# Sprache der Oberfläche: de | en | auto (= Browser-/Smartphone-Sprache)
UI_LANG=auto
# Sprache des Admin-Webinterfaces (Port 8444): en | de; umschaltbar oben rechts auf den Seiten
ADMIN_LANG=en

# Unter welchen Adressen ist der Server erreichbar? (IP und/oder DNS-Name, kommagetrennt)
# Wichtig: Diese Namen kommen ins selbstsignierte Zertifikat. Die App prüft sie.
# Beispiel: NUORB_HOSTS=192.168.178.50,nuorb.fritz.box
NUORB_HOSTS=

# Öffentliche Ports auf dem Host (ändern, falls 8443/8444 belegt sind)
NUORB_UI_PORT_PUBLIC=8443
NUORB_ADMIN_PORT_PUBLIC=8444
# Nur an eine Adresse binden (z. B. 127.0.0.1 hinter einem Reverse-Proxy oder die VPN-Adresse)
NUORB_BIND=0.0.0.0

# --- Gehirn (optional schon hier; sonst im Admin-Panel unter „Einrichtung“) ---------------
# Ollama im Heimnetz (z. B. Gaming-PC). Hermes braucht >= 64k Kontext: am Ollama-Server OLLAMA_CONTEXT_LENGTH=65536 setzen!
NUORB_INIT_OLLAMA_URL=
NUORB_INIT_OLLAMA_MODEL=
NUORB_INIT_CONTEXT=65536
# local | auto | remote   (leer = automatisch passend)
NUORB_INIT_BRAIN=
NUORB_INIT_CLAUDE_MODEL=claude-haiku-5-5
# Nur wenn du den Schlüssel nicht im Admin-Panel eintragen willst (wird einmal übernommen):
NUORB_INIT_ANTHROPIC_API_KEY=

# --- Sicherheit --------------------------------------------------------------------------
# Geräte müssen sich per Einmal-Code koppeln (empfohlen). 0 = jeder im Heimnetz darf die Oberfläche nutzen.
NUORB_REQUIRE_PAIRING=1
# Aus welchen Netzen Zugriffe erlaubt sind (Standard: private Netze, Tailscale/CGNAT, IPv6-ULA)
NUORB_ALLOWED_NETS=

# --- TLS ---------------------------------------------------------------------------------
# selfsigned = eigene Heim-CA (Fingerabdruck steckt im QR-Code der App)
# custom     = eigenes Zertifikat: NUORB_TLS_CERT / NUORB_TLS_KEY + Ordner in compose.yaml einbinden
# off        = kein TLS im Container, ein Reverse-Proxy (z. B. Caddy) macht HTTPS davor
NUORB_TLS=selfsigned
NUORB_TLS_CERT=/certs/fullchain.pem
NUORB_TLS_KEY=/certs/privkey.pem
# Adresse für QR-Code/Kopplung, wenn sie vom Admin-Aufruf abweicht (z. B. https://nuorb.example.ts.net:8443)
NUORB_PUBLIC_URL=

# --- Stimme ------------------------------------------------------------------------------
# Leer = de_DE-thorsten-medium (de) bzw. en_GB-alan-medium (en). Weitere Piper-Stimmen kommagetrennt:
NUORB_VOICE=
NUORB_EXTRA_VOICES=

# Hermes-Benutzer im Container auf eine Host-UID abbilden (nur bei Bind-Mounts nötig)
# HERMES_UID=1000
# HERMES_GID=1000

# Server im Heimnetz ankündigen (mDNS _nuorb._tcp), nur mit network_mode: host wirksam
NUORB_MDNS=0

# Image-Version (Standard latest), z. B. NUORB_VERSION=1.0.0
# NUORB_VERSION=latest
