# Testlauf: Mock-LLM auf dem Host (docker/tools/mock-llm.py), kein echter Schlüssel.
NUORB_LANG=de
NUORB_NAME=NuOrb-Test
TZ=Europe/Berlin
NUORB_HOSTS=127.0.0.1,localhost
NUORB_INIT_OLLAMA_URL=http://127.0.0.1:18434
NUORB_INIT_OLLAMA_MODEL=mock-nuorb
NUORB_INIT_CONTEXT=65536
NUORB_REQUIRE_PAIRING=1
NUORB_TLS=selfsigned
# Wetter nur gegen den lokalen Mock (docker/tools/mock-weather.py), nie echte Abfragen im Test
NUORB_WEATHER_MOCK=http://127.0.0.1:18440
# Update-Prüfung gegen den Mock (nur 127.0.0.1 wird angenommen), nie gegen GitHub
NUORB_UPDATE_URL=http://127.0.0.1:18434/mock/release
