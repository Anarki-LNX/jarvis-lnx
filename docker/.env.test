# Testlauf: Mock-LLM auf dem Host (docker/tools/mock-llm.py), kein echter Schlüssel.
JARVIS_LANG=de
JARVIS_NAME=JARVIS-Test
TZ=Europe/Berlin
JARVIS_HOSTS=127.0.0.1,localhost
JARVIS_INIT_OLLAMA_URL=http://127.0.0.1:18434
JARVIS_INIT_OLLAMA_MODEL=mock-jarvis
JARVIS_INIT_CONTEXT=65536
JARVIS_REQUIRE_PAIRING=1
JARVIS_TLS=selfsigned
