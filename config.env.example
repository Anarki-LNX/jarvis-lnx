# NuOrb: site configuration (example)
#
# The original setup used fixed LAN addresses. In this repository they are replaced by
# the placeholders below. Copy this file to config.env (git-ignored), fill in your own
# addresses and `source config.env` before running the helper scripts from your PC.
#
#   Placeholder      Meaning                                              Used by
#   -----------      -------                                              -------
#   NUORB_SERVER_IP  the NuOrb server (UI :8443, admin panel :8444)       scripts/, voice/, nixos/site.nix
#   PHONE_HOST       the phone (NixOS, WLAN address)                      scripts/handy-*
#   OLLAMA_HOST      PC with the GPU running Ollama (:11434)              scripts/steuerung-fallback-test.sh,
#                                                                         scripts/backend-ollama-*
#   PROXMOX_HOST     Proxmox VE host that runs the LXC (only for setup)   scripts/nuorb-lxc-base.sh (comment)
#   APT_CACHE_HOST   optional apt cache (apt-cacher style, :8080/apt)     scripts/nuorb-lxc-base.sh
#
# Places where a placeholder is a literal string and must be edited by hand:
#   nixos/site.nix                     nuorbHost = "NUORB_SERVER_IP";
#
# The Docker server itself does not use this file, see docker/.env.example.

NUORB_SERVER_IP=192.0.2.10
PHONE_HOST=192.0.2.20
OLLAMA_HOST=192.0.2.30
PROXMOX_HOST=192.0.2.2
APT_CACHE_HOST=
