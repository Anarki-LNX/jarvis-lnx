---
// Grundgerüst jeder Seite: Meta/SEO (Title, Description, Canonical, hreflang, Open Graph, Twitter, JSON-LD),
// selbst gehostete Schriften, globale Styles. Keine externen Ressourcen.
import "../styles/global.css";
import { SITE_URL, GITHUB } from "../config";
import type { Lang } from "../i18n";
import { t } from "../i18n";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;            // kanonischer Pfad dieser Seite, z. B. "/en/"
  alternates?: { en: string; de: string }; // Pfade der Sprachversionen
  noindex?: boolean;
  jsonLd?: boolean;
}
const { lang, title, description, path, alternates, noindex = false, jsonLd = false } = Astro.props;
const d = t(lang);
const canonical = new URL(path, SITE_URL).href;
const og = new URL(`/img/og-${lang}.png`, SITE_URL).href;
const ld = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "NuOrb",
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Linux (Docker), amd64/arm64",
  description: d.meta.description,
  url: SITE_URL + `/${lang}/`,
  license: "https://opensource.org/licenses/MIT",
  isAccessibleForFree: true,
  codeRepository: GITHUB.repo,
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
  inLanguage: lang,
};
---
<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates && (
      <>
        <link rel="alternate" hreflang="en" href={new URL(alternates.en, SITE_URL).href} />
        <link rel="alternate" hreflang="de" href={new URL(alternates.de, SITE_URL).href} />
        <link rel="alternate" hreflang="x-default" href={SITE_URL + "/"} />
      </>
    )}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#05060a" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/space-grotesk-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NuOrb" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={d.meta.ogAlt} />
    <meta property="og:locale" content={d.locale} />
    <meta property="og:locale:alternate" content={lang === "en" ? "de_DE" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{d.skip}</a>
    <slot />
  </body>
</html>
