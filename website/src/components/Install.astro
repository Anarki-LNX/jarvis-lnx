---
// Installationsbefehl nur zum Kopieren – die Website führt nie etwas aus.
import { t, type Lang } from "../i18n";
import { GITHUB, INSTALL_CMD, INSTALL_CMD_DE, YOUTUBE } from "../config";
import Icon from "./Icon.astro";
import media from "../data/media.json";
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).install;
const cmd = lang === "de" ? INSTALL_CMD_DE : INSTALL_CMD;
const tutorialUrl = lang === "de" ? YOUTUBE.tutorialDe : YOUTUBE.tutorialEn;
type Clip = { id: string; video: { src: string; type: string; w: number }[]; poster: Record<string, string>; tracks: { src: string; srclang: string; label: string }[]; alt: Record<string, string> };
const tut = (media as { clips: Clip[] }).clips.find((c) => c.id === `install-tutorial-${lang}`);
const tutSources = tut ? ["video/webm", "video/mp4"].map((ty) => tut.video.filter((v) => v.type.startsWith(ty)).sort((a, b) => a.w - b.w).find((v) => v.w >= 1280) ?? tut.video.filter((v) => v.type.startsWith(ty)).at(-1)).filter(Boolean) : [];
---
<section class="section" id="install" aria-labelledby="install-title">
  <div class="wrap">
    <div class="head reveal">
      <p class="kicker">{d.kicker}</p>
      <h2 id="install-title">{d.title}</h2>
    </div>
    <div class="grid">
      <div class="main reveal">
        <div class="cmd">
          <div class="cmd__bar"><span>{d.commandLabel}</span>
            <button type="button" class="btn btn--glass btn--sm" data-copy={cmd} data-copied={d.copied} hidden><Icon name="copy" /><span>{d.copy}</span></button>
          </div>
          <pre><code><span class="p" aria-hidden="true">$ </span>{cmd}</code></pre>
        </div>
        <p class="bn">{d.browserNote}</p>
        <h3 class="sub">{d.stepsTitle}</h3>
        <ol class="ol">{d.steps.map((s) => <li>{s}</li>)}</ol>
        <div class="notice notice--warn" role="note"><Icon name="warn" /><div><strong>{d.warnTitle}</strong>{d.warnText}</div></div>
        {tut && tutSources.length > 0 && (
          <figure class="tut">
            <video controls preload="none" playsinline poster={tut.poster.jpg || tut.poster.webp} aria-label={tut.alt[lang] || tut.alt.en}>
              {tutSources.map((v) => v && <source src={v.src} type={v.type} />)}
              {tut.tracks.map((tr) => <track kind="subtitles" src={tr.src} srclang={tr.srclang} label={tr.label} />)}
            </video>
            <figcaption>{t(lang).demo.label}</figcaption>
          </figure>
        )}
      </div>
      <aside class="side reveal">
        <div class="card">
          <h3>{d.requirementsTitle}</h3>
          <ul class="req">{d.requirements.map((r) => <li><Icon name="check" />{r}</li>)}</ul>
        </div>
        <nav class="links" aria-label={d.kicker}>
          <a href={lang === "de" ? GITHUB.installDe : GITHUB.install} rel="noopener"><Icon name="code" />{lang === "de" ? d.docsDe : d.docsEn}<Icon name="external" class="ext" /></a>
          <a href={lang === "de" ? GITHUB.install : GITHUB.installDe} rel="noopener" hreflang={lang === "de" ? "en" : "de"}><Icon name="globe" />{lang === "de" ? d.docsEn : d.docsDe}<Icon name="external" class="ext" /></a>
          <a href={GITHUB.docker} rel="noopener"><Icon name="server" />{d.docker}<Icon name="external" class="ext" /></a>
          <a href={tutorialUrl} rel="noopener"><Icon name="youtube" />{d.video}<Icon name="external" class="ext" /></a>
          <a href={GITHUB.repo} rel="noopener"><Icon name="github" />{d.repo}<Icon name="external" class="ext" /></a>
        </nav>
      </aside>
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3rem); align-items: start; }
  .main { display: grid; gap: 1.3rem; min-width: 0; }
  .cmd { border: 1px solid var(--line-2); border-radius: var(--r-md); background: #070a12; overflow: hidden; box-shadow: 0 0 60px rgba(56, 217, 255, .06); }
  .cmd__bar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: .55rem .6rem .55rem 1.1rem; border-bottom: 1px solid var(--line); font: 500 .74rem/1 var(--f-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--text-3); }
  .cmd__bar .btn { text-transform: none; letter-spacing: 0; }
  .cmd__bar .btn[hidden] { display: none; }
  pre { margin: 0; padding: 1.2rem 1.1rem; overflow-x: auto; font: 400 .95rem/1.6 var(--f-mono); color: var(--text); white-space: pre-wrap; word-break: break-all; }
  .p { color: var(--cyan); user-select: none; }
  .bn { font-size: .9rem; color: var(--text-3); }
  .sub { font-size: 1.15rem; margin-top: .6rem; }
  .ol { margin: 0; padding-left: 1.3rem; display: grid; gap: .45rem; color: var(--text-2); }
  .ol li::marker { color: var(--cyan); font-family: var(--f-mono); }
  .tut { margin: .6rem 0 0; display: grid; gap: .6rem; }
  .tut video { width: 100%; aspect-ratio: 16 / 9; border-radius: var(--r-md); border: 1px solid var(--line-2); background: #000; }
  .tut figcaption { font-size: .82rem; color: var(--text-3); }
  .side { display: grid; gap: 1rem; }
  .req { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: .7rem; }
  .req li { display: grid; grid-template-columns: auto 1fr; gap: .6rem; color: var(--text-2); font-size: .95rem; }
  .req :global(svg) { width: 18px; height: 18px; color: var(--mint); margin-top: .2rem; }
  .links { display: grid; gap: .4rem; }
  .links a { display: grid; grid-template-columns: auto 1fr auto; gap: .7rem; align-items: center; min-height: 48px; padding: .6rem 1rem; border: 1px solid var(--line); border-radius: var(--r-sm); color: var(--text); text-decoration: none; font-weight: 500; font-size: .95rem; }
  .links a:hover { border-color: var(--line-2); background: var(--glass); }
  .links :global(svg) { width: 18px; height: 18px; color: var(--cyan); }
  .links :global(.ext) { width: 14px; height: 14px; color: var(--text-3); }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
</style>
