---
// Hero mit der echten NuOrb-Orb-Animation (ui/static/orb.js: WebGL → Canvas 2D → CSS-Fallback).
// Rein visuell: kein Mikrofon, keine KI-Verbindung. Zustände laufen als Vorführung durch (site.ts).
import { t, type Lang } from "../i18n";
import Icon from "./Icon.astro";
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).hero;
const s = d.states;
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="wrap wrap--wide hero__in">
    <div class="hero__copy">
      <p class="kicker">{d.eyebrow}</p>
      <h1 id="hero-title" class="hero__title">{d.title.map((l, i) => <>{i > 0 && " "}<span class={`l l${i}`}>{l}</span></>)}</h1>
      <p class="lead hero__lead">{d.lead}</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href="#install">{d.start}<Icon name="arrow" /></a>
        <a class="btn btn--glass" href="#demo"><Icon name="play" />{d.demo}</a>
        <a class="btn btn--glass hero__explore" href="#what">{d.explore}</a>
      </div>
      <ul class="badges hero__badges" aria-label="NuOrb">
        {d.badges.map((b, i) => <li class={`badge ${i === 3 ? "badge--local" : ""}`}>{b}</li>)}
      </ul>
    </div>
    <div class="hero__stage">
      <div class="hero__orb" data-orb="css" data-state="idle" data-hero-orb role="img" aria-label={d.orbLabel}>
        <div class="orb-wrap">
          <div class="orb-css" aria-hidden="true"><div class="oc-glow"></div><div class="oc-ring r1"></div><div class="oc-ring r2"></div><div class="oc-core"></div></div>
          <canvas id="orb" width="600" height="600" aria-hidden="true"></canvas>
        </div>
      </div>
      <p class="hero__state" aria-hidden="true"><span class="dot"></span><span data-orb-state data-labels={JSON.stringify(s)}>{s.idle}</span></p>
      <p class="hero__hint">{d.orbHint}</p>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; min-height: min(100svh, 980px); display: grid; align-items: center; padding-block: clamp(2rem, 6vw, 5rem) clamp(3rem, 8vw, 6rem); margin-top: -68px; padding-top: calc(68px + clamp(2rem, 6vw, 5rem)); overflow: hidden; }
  .hero__bg { position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(900px 600px at 72% 45%, rgba(56, 217, 255, .13), transparent 62%),
      radial-gradient(700px 500px at 15% 10%, rgba(79, 125, 255, .10), transparent 60%),
      radial-gradient(600px 500px at 90% 100%, rgba(139, 108, 255, .08), transparent 60%); }
  .hero__bg::after { content: ""; position: absolute; inset: 0; opacity: .35;
    background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 64px 64px; mask-image: radial-gradient(ellipse at 60% 40%, #000 10%, transparent 70%); -webkit-mask-image: radial-gradient(ellipse at 60% 40%, #000 10%, transparent 70%); }
  .hero__in { position: relative; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .hero__copy { display: grid; gap: 1.6rem; }
  .hero__title { font-size: clamp(2.5rem, 5.4vw, 5.4rem); line-height: 1; letter-spacing: -.035em; }
  .hero__title .l { display: block; }
  @media (min-width: 380px) { .hero__title .l { white-space: nowrap; } }
  .hero__title .l1 { background: linear-gradient(92deg, #fff 0%, var(--cyan) 55%, var(--blue) 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hero__title .l2 { color: var(--text-2); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: .75rem; }
  .hero__badges { list-style: none; padding: 0; margin: 0; }
  .hero__stage { position: relative; display: grid; justify-items: center; gap: 1rem; }
  .hero__orb { position: relative; width: min(100%, 560px); aspect-ratio: 1; }
  .orb-wrap { position: absolute; inset: 0; }
  #orb { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero__state { display: inline-flex; align-items: center; gap: .55rem; font: 500 .8rem/1 var(--f-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--text-2);
    padding: .55rem .9rem; border: 1px solid var(--line-2); border-radius: 999px; background: rgba(5, 6, 10, .5); margin: -1.5rem 0 0; }
  .hero__state .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 10px var(--cyan); }
  .hero__hint { font-size: .85rem; color: var(--text-3); text-align: center; max-width: 40ch; }
  @media (max-width: 900px) {
    .hero { min-height: 0; }
    .hero__in { grid-template-columns: 1fr; }
    .hero__stage { order: -1; }
    .hero__orb { width: min(78vw, 400px); }
    .hero__explore { display: none; }
  }
  @media (max-width: 520px) { .hero__cta .btn { flex: 1 1 100%; } }
</style>
