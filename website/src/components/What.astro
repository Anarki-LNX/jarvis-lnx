---
import { t, type Lang } from "../i18n";
import Icon from "./Icon.astro";
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).what;
const n = d.nodes;
---
<section class="section" id="what" aria-labelledby="what-title">
  <div class="wrap">
    <div class="head reveal">
      <p class="kicker">{d.kicker}</p>
      <h2 id="what-title">{d.title}</h2>
      <p class="lead">{d.text}</p>
    </div>
    <figure class="arch reveal" aria-labelledby="arch-cap">
      <figcaption id="arch-cap"><span class="arch__t">{d.archTitle}</span><span class="sr-only"> – {d.archDesc}</span></figcaption>
      <div class="arch__grid" aria-hidden="true">
        <div class="node node--client"><Icon name="phone" /><strong>{n.client[0]}</strong><span>{n.client[1]}</span></div>
        <div class="link link--a"><i></i></div>
        <div class="node node--server">
          <div class="node__head"><Icon name="server" /><strong>{n.server[0]}</strong><span>{n.server[1]}</span></div>
          <div class="sub">
            <div><Icon name="mic" /><b>{n.stt[0]}</b><small>{n.stt[1]}</small></div>
            <div><Icon name="chip" /><b>{n.agent[0]}</b><small>{n.agent[1]}</small></div>
            <div><Icon name="sound" /><b>{n.tts[0]}</b><small>{n.tts[1]}</small></div>
          </div>
        </div>
        <div class="link link--b"><i></i></div>
        <div class="outs">
          <div class="node node--local"><Icon name="chip" /><strong>{n.llm[0]}</strong><span>{n.llm[1]}</span></div>
          <div class="node node--opt"><Icon name="cloud" /><strong>{n.cloud[0]}</strong><span>{n.cloud[1]}</span></div>
          <div class="node node--opt"><Icon name="home" /><strong>{n.home[0]}</strong><span>{n.home[1]}</span></div>
        </div>
      </div>
      <ul class="arch__legend">
        <li class="badge badge--local">{d.legendLocal}</li>
        <li class="badge badge--optional">{d.legendOptional}</li>
      </ul>
    </figure>
  </div>
</section>

<style>
  .arch { margin: 0; padding: clamp(1.2rem, 3vw, 2.5rem); border: 1px solid var(--line); border-radius: var(--r-lg);
    background: radial-gradient(800px 300px at 50% 0, rgba(56, 217, 255, .06), transparent 70%), var(--ink-1); }
  .arch__t { display: block; font: 500 .78rem/1 var(--f-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--text-3); margin-bottom: 1.6rem; }
  .arch__grid { display: grid; grid-template-columns: minmax(0, .8fr) 48px minmax(0, 1.5fr) 48px minmax(0, 1fr); align-items: center; }
  .node { position: relative; display: grid; gap: .3rem; padding: 1.1rem 1.15rem; border-radius: var(--r-md); border: 1px solid var(--line-2); background: rgba(255,255,255,.03); }
  .node :global(svg) { width: 22px; height: 22px; color: var(--cyan); margin-bottom: .3rem; }
  .node strong { font: 600 1.02rem/1.25 var(--f-display); }
  .node span { font-size: .88rem; color: var(--text-2); line-height: 1.45; }
  .node--server { border-color: rgba(56, 217, 255, .4); background: linear-gradient(180deg, rgba(56, 217, 255, .08), rgba(56, 217, 255, .02)); box-shadow: 0 0 60px rgba(56, 217, 255, .08); gap: 1rem; }
  .node__head { display: grid; gap: .3rem; }
  .sub { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .6rem; }
  .sub > div { display: grid; gap: .2rem; padding: .8rem; border-radius: var(--r-sm); border: 1px solid var(--line); background: rgba(5, 6, 10, .5); }
  .sub :global(svg) { width: 18px; height: 18px; color: var(--mint); margin: 0 0 .2rem; }
  .sub b { font-size: .86rem; font-weight: 600; }
  .sub small { font-size: .76rem; color: var(--text-3); line-height: 1.4; }
  .outs { display: grid; gap: .7rem; }
  .node--local { border-color: rgba(78, 230, 168, .4); }
  .node--local :global(svg) { color: var(--mint); }
  .node--opt { border-style: dashed; }
  .node--opt :global(svg) { color: var(--violet); }
  .link { position: relative; height: 2px; }
  .link i { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(56,217,255,.15), rgba(56,217,255,.7), rgba(56,217,255,.15)); background-size: 200% 100%; animation: flow 2.4s linear infinite; }
  @keyframes flow { to { background-position: -200% 0; } }
  .arch__legend { list-style: none; padding: 0; margin: 1.6rem 0 0; display: flex; flex-wrap: wrap; gap: .6rem; }
  .arch__legend .badge { text-transform: none; letter-spacing: 0; font-family: var(--f-text); font-size: .82rem; }
  @media (max-width: 960px) {
    .arch__grid { grid-template-columns: 1fr; }
    .link { width: 2px; height: 32px; margin-inline: auto; }
    .link i { background: linear-gradient(180deg, rgba(56,217,255,.15), rgba(56,217,255,.7), rgba(56,217,255,.15)); background-size: 100% 200%; animation-name: flowv; }
    @keyframes flowv { to { background-position: 0 -200%; } }
  }
  @media (max-width: 560px) { .sub { grid-template-columns: 1fr; } }
</style>
