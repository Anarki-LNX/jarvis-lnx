---
// Befehl nur zum Kopieren: die Website führt nie etwas aus. Mehrzeilig erlaubt (jede Zeile mit Prompt).
import Icon from "./Icon.astro";
interface Props { label: string; code: string; copy: string; copied: string }
const { label, code, copy, copied } = Astro.props;
const lines = code.split("\n");
---
<div class="cmd">
  <div class="cmd__bar"><span>{label}</span>
    <button type="button" class="btn btn--glass btn--sm" data-copy={code} data-copied={copied} hidden><Icon name="copy" /><span>{copy}</span></button>
  </div>
  <pre><code>{lines.map((l, i) => <>{i > 0 && "\n"}<span class="p" aria-hidden="true">$ </span>{l}</>)}</code></pre>
</div>

<style>
  .cmd { border: 1px solid var(--line-2); border-radius: var(--r-md); background: #070a12; overflow: hidden; box-shadow: 0 0 60px rgba(56, 217, 255, .06); min-width: 0; }
  .cmd__bar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; min-height: 50px; padding: .45rem .6rem .45rem 1.1rem; border-bottom: 1px solid var(--line); font: 500 .74rem/1.3 var(--f-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--text-3); }
  .cmd__bar .btn { text-transform: none; letter-spacing: 0; flex: none; }
  .cmd__bar .btn[hidden] { display: none; }
  pre { margin: 0; padding: 1.1rem 1.1rem; overflow-x: auto; font: 400 .92rem/1.65 var(--f-mono); color: var(--text); white-space: pre-wrap; word-break: break-all; }
  .p { color: var(--cyan); user-select: none; }
</style>
