---
// Open Source. Die neueste Release-Version wird NUR beim Build von der GitHub-API geholt (Zeitlimit),
// nie im Browser des Besuchers. Schlägt das fehl, entfällt die Zeile einfach.
import { t, type Lang } from "../i18n";
import { GITHUB, THIRD_PARTY } from "../config";
import Icon from "./Icon.astro";
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).oss;

let release: { tag: string; url: string; date: string } | null = null;
if (process.env.NUORB_OFFLINE !== "1") {
  try {
    const r = await fetch(GITHUB.api + "/releases/latest", { signal: AbortSignal.timeout(6000), headers: { Accept: "application/vnd.github+json", "User-Agent": "nuorb-website-build" } });
    if (r.ok) {
      const j = await r.json();
      const tag = String(j.tag_name || "");
      const url = String(j.html_url || "");
      if (/^v?\d+\.\d+(\.\d+)?[\w.-]*$/.test(tag) && url.startsWith(GITHUB.releases + "/")) {
        release = { tag, url, date: new Date(j.published_at).toLocaleDateString(lang === "de" ? "de-DE" : "en-GB", { year: "numeric", month: "long", day: "numeric", timeZone: "Europe/Berlin" }) };
      }
    }
  } catch { /* offline oder Rate-Limit: Zeile entfällt */ }
}
const links = [
  [GITHUB.repo, d.links.code, "code"], [GITHUB.issues, d.links.issues, "chat"], [GITHUB.pulls, d.links.pulls, "github"],
  [GITHUB.contributing, d.links.contributing, "user"], [GITHUB.aiDeclaration, d.links.ai, "chip"], [GITHUB.license, d.links.license, "shield"],
  [GITHUB.releases, d.links.releases, "star"],
];
---
<section class="section" id="open-source" aria-labelledby="oss-title">
  <div class="wrap">
    <div class="box reveal">
      <div class="copy">
        <p class="kicker">{d.kicker}</p>
        <h2 id="oss-title">{d.title}</h2>
        <p class="lead">{d.text}</p>
        <div class="row">
          <a class="btn btn--primary" href={GITHUB.repo} rel="noopener"><Icon name="github" />{d.github}</a>
          {release && <a class="rel" href={release.url} rel="noopener"><span class="rel__k">{d.release}</span> <span class="rel__v"><b>{d.version} {release.tag}</b> <span aria-hidden="true">·</span> <small>{d.releasedOn} {release.date}</small></span></a>}
        </div>
        <p class="small">{d.aiNote}</p>
        <p class="small">{d.credits} <a href={THIRD_PARTY} rel="noopener">{t(lang).footer.licenses}</a></p>
      </div>
      <ul class="links">
        {links.map(([href, label, icon]) => <li><a href={href} rel="noopener"><Icon name={icon} />{label}<Icon name="external" class="ext" /></a></li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .box { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, .7fr); gap: clamp(2rem, 5vw, 4rem); padding: clamp(1.5rem, 4vw, 3.5rem); border-radius: var(--r-lg); border: 1px solid var(--line-2);
    background: radial-gradient(600px 300px at 0 0, rgba(79, 125, 255, .12), transparent 70%), radial-gradient(500px 300px at 100% 100%, rgba(56, 217, 255, .08), transparent 70%), var(--ink-1); }
  .copy { display: grid; gap: 1.1rem; align-content: start; }
  .row { display: flex; flex-wrap: wrap; gap: .8rem; align-items: center; margin-top: .4rem; }
  .rel { display: inline-grid; gap: .3rem; min-height: 48px; padding: .65rem 1rem; border: 1px solid var(--line-2); border-radius: var(--r-sm); color: var(--text-2); text-decoration: none; font-size: .9rem; }
  .rel__k { font: 500 .7rem/1 var(--f-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--text-3); }
  .rel__v { display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: .1rem .45rem; }
  .rel b { font: 600 .95rem/1.3 var(--f-mono); color: var(--mint); }
  .rel small { font-size: .88rem; color: var(--text-2); }
  .rel:hover { border-color: rgba(170,190,255,.3); }
  .small { font-size: .9rem; color: var(--text-3); max-width: 64ch; }
  .links { list-style: none; padding: 0; margin: 0; display: grid; gap: .4rem; align-content: start; }
  .links a { display: grid; grid-template-columns: auto 1fr auto; gap: .7rem; align-items: center; min-height: 48px; padding: .6rem 1rem; border: 1px solid var(--line); border-radius: var(--r-sm); color: var(--text); text-decoration: none; font-weight: 500; font-size: .95rem; background: rgba(5,6,10,.4); }
  .links a:hover { border-color: var(--line-2); background: var(--glass); }
  .links :global(svg) { width: 18px; height: 18px; color: var(--cyan); }
  .links :global(.ext) { width: 14px; height: 14px; color: var(--text-3); }
  @media (max-width: 860px) { .box { grid-template-columns: 1fr; } }
</style>
