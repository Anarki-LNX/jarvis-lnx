---
import { t, type Lang } from "../i18n";
import Icon from "./Icon.astro";
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).privacy;
const cls: Record<string, string> = { local: "badge--local", optional: "badge--optional", once: "", none: "badge--local" };
---
<section class="section" id="privacy" aria-labelledby="privacy-title">
  <div class="wrap">
    <div class="head reveal">
      <p class="kicker">{d.kicker}</p>
      <h2 id="privacy-title">{d.title}</h2>
      <p class="lead">{d.text}</p>
    </div>
    <div class="tbl reveal" role="region" aria-labelledby="privacy-title" tabindex="0">
      <table>
        <thead><tr>{d.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
        <tbody>
          {d.rows.map(([what, where, kind]) => (
            <tr><th scope="row">{what}</th><td>{where}</td><td><span class={`badge ${cls[kind] ?? ""}`}>{d.labels[kind as keyof typeof d.labels]}</span></td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note reveal"><Icon name="lock" />{d.note}</p>
  </div>
</section>

<style>
  .tbl { border: 1px solid var(--line); border-radius: var(--r-md); overflow-x: auto; background: var(--ink-1); }
  table { width: 100%; border-collapse: collapse; min-width: 560px; }
  th, td { text-align: left; padding: 1.05rem 1.3rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  tbody tr:last-child > * { border-bottom: 0; }
  thead th { font: 500 .74rem/1 var(--f-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--text-3); background: rgba(255,255,255,.02); }
  tbody th { font-weight: 600; width: 32%; }
  td { color: var(--text-2); }
  td:last-child { width: 1%; white-space: nowrap; }
  .badge { text-transform: none; letter-spacing: 0; font-family: var(--f-text); font-size: .8rem; }
  .note { display: flex; gap: .7rem; align-items: flex-start; margin-top: 1.4rem; color: var(--text-2); font-size: .95rem; max-width: 70ch; }
  .note :global(svg) { width: 20px; height: 20px; flex: none; color: var(--mint); margin-top: .15rem; }
</style>
